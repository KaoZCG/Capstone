# Required for registration, login and saving profiles in Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Ollama downloads this model into the persistent Docker volume on first launch.
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=900

# The URL the browser uses to reach the API exposed by Docker.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_URL=http://localhost:3000
